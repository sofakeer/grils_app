   // 获取心形货币数量
   int getHeartCount() {
-    return _prefs.getInt(_keyHeartCount) ?? 0;
+    final hearts = UserService.instance.heartCount;
+    if (_isInitialized) {
+      final cached = _prefs.getInt(_keyHeartCount);
+      if (cached != hearts) {
+        _prefs.setInt(_keyHeartCount, hearts);
+      }
+    }
+    return hearts;
   }
 
   // 设置心形货币数量
   Future<void> setHeartCount(int count) async {
